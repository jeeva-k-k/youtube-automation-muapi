  "captions": [
    {
      "start": 0.25,
      "end": 4.3,
      "text": "Gravity does not just pull on objects;",
      "words": [
        {
          "text": "Gravity",
          "start": 0.25,
          "end": 1.27
        },
        {
          "text": "does",
          "start": 1.27,
          "end": 1.8
        },
        {
          "text": "not",
          "start": 1.8,
          "end": 2.09
        },
        {
          "text": "just",
          "start": 2.09,
          "end": 2.62
        },
        {
          "text": "pull",
          "start": 2.62,
          "end": 3.07
        },
        {
          "text": "on",
          "start": 3.07,
          "end": 3.46
        },
        {
          "text": "objects;",
          "start": 3.46,
          "end": 4.3
        }
      ]
    },
    {
      "start": 4.3,
      "end": 6.76,
      "text": "it pulls on time itself.",
      "words": [
        {
          "text": "it",
          "start": 4.3,
          "end": 4.6
        },
        {
          "text": "pulls",
          "start": 4.6,
          "end": 5.12
        },
        {
          "text": "on",
          "start": 5.12,
          "end": 5.42
        },
        {
