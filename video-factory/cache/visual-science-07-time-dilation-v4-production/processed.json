          "start": 5.42,
          "end": 6.05
        },
        {
          "text": "itself.",
          "start": 6.05,
          "end": 6.76
        }
      ]
    },
    {
      "start": 6.76,
      "end": 10.45,
      "text": "According to Einsteins General Relativity,",
      "words": [
        {
          "text": "According",
          "start": 6.76,
          "end": 7.65
        },
        {
          "text": "to",
          "start": 7.65,
          "end": 7.79
        },
        {
          "text": "Einsteins",
          "start": 7.79,
          "end": 8.52
        },
        {
          "text": "General",
          "start": 8.52,
          "end": 9.27
        },
        {
          "text": "Relativity,",
          "start": 9.27,
          "end": 10.45
        }
      ]
    },
    {
      "start": 10.45,
      "end": 14.13,
      "text": "massive bodies warp space-time.",
      "words": [
        {
          "text": "massive",
          "start": 10.45,
          "end": 11.53
        },
        {
          "text": "bodies",
          "start": 11.53,
          "end": 12.27
        },
        {
          "text": "warp",
          "start": 12.27,
          "end": 12.8
        },
        {
          "text": "space-time.",
          "start": 12.8,
          "end": 14.13
        }
      ]
    },
    {
      "start": 14.13,
      "end": 17.82,
      "text": "The stronger the gravity, the more time stretches.",
      "words": [
        {
          "text": "The",
          "start": 14.13,
          "end": 14.43
        },
        {
          "text": "stronger",
          "start": 14.43,
          "end": 15.04
        },
        {
          "text": "the",
          "start": 15.04,
          "end": 15.32
        },
        {
          "text": "gravity,",
          "start": 15.32,
          "end": 16.01
        },
        {
          "text": "the",
          "start": 16.01,
          "end": 16.26
        },
        {
          "text": "more",
          "start": 16.26,
          "end": 16.73
        },
        {
          "text": "time",
          "start": 16.73,
          "end": 17.11
        },
        {
          "text": "stretches.",
          "start": 17.11,
          "end": 17.82
        }
      ]
    },
    {
      "start": 17.82,
      "end": 21.51,
      "text": "Near a black hole, time slows to a crawl.",
      "words": [
        {
          "text": "Near",
          "start": 17.82,
          "end": 18.29
        },
        {
          "text": "a",
          "start": 18.29,
          "end": 18.45
        },
        {
          "text": "black",
          "start": 18.45,
          "end": 18.95
        },
        {
          "text": "hole,",
          "start": 18.95,
          "end": 19.44
        },
        {
          "text": "time",
          "start": 19.44,
          "end": 20.05
        },
        {
          "text": "slows",
          "start": 20.05,
          "end": 20.53
        },
        {
          "text": "to",
          "start": 20.53,
          "end": 20.83
        },
        {
          "text": "a",
          "start": 20.83,
          "end": 20.96
        },
        {
          "text": "crawl.",
