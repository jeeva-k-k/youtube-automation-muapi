          "start": 12.11,
          "end": 12.8
        },
        {
          "text": "pathway.",
          "start": 12.8,
          "end": 13.33
        }
      ]
    },
    {
      "start": 13.33,
      "end": 17.06,
      "text": "This happens due to cross activation",
      "words": [
        {
          "text": "This",
          "start": 13.33,
          "end": 13.74
        },
        {
          "text": "happens",
          "start": 13.74,
