          "text": "word,",
          "start": 1.77,
          "end": 2.13
        }
      ]
    },
    {
      "start": 2.13,
      "end": 3.73,
      "text": "or hearing the color green.",
      "words": [
        {
          "text": "or",
          "start": 2.13,
          "end": 2.32
        },
        {
          "text": "hearing",
          "start": 2.32,
          "end": 2.81
        },
        {
