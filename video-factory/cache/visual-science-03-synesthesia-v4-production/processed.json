          "end": 3.42
        },
        {
          "text": "green.",
          "start": 3.42,
          "end": 3.73
        }
      ]
    },
    {
      "start": 3.73,
      "end": 6.4,
      "text": "This sensory blending is called synesthesia.",
      "words": [
        {
          "text": "This",
          "start": 3.73,
          "end": 3.93
        },
        {
          "text": "sensory",
          "start": 3.93,
          "end": 4.55
        },
        {
          "text": "blending",
          "start": 4.55,
          "end": 4.98
        },
        {
          "text": "is",
          "start": 4.98,
          "end": 5.22
        },
        {
          "text": "called",
          "start": 5.22,
          "end": 5.66
        },
        {
          "text": "synesthesia.",
          "start": 5.66,
          "end": 6.4
        }
      ]
    },
    {
      "start": 6.4,
      "end": 8.53,
      "text": "It is a neurological condition",
      "words": [
        {
          "text": "It",
          "start": 6.4,
          "end": 6.61
        },
        {
          "text": "is",
          "start": 6.61,
          "end": 6.76
        },
        {
          "text": "a",
          "start": 6.76,
          "end": 6.86
        },
        {
          "text": "neurological",
          "start": 6.86,
          "end": 7.91
        },
        {
          "text": "condition",
          "start": 7.91,
          "end": 8.53
        }
      ]
    },
    {
      "start": 8.53,
      "end": 10.13,
      "text": "where stimulation of one sensory pathway",
      "words": [
        {
          "text": "where",
          "start": 8.53,
          "end": 8.77
        },
        {
          "text": "stimulation",
          "start": 8.77,
          "end": 9.28
        },
        {
          "text": "of",
          "start": 9.28,
          "end": 9.34
        },
        {
          "text": "one",
          "start": 9.34,
          "end": 9.52
        },
        {
          "text": "sensory",
          "start": 9.52,
          "end": 9.85
        },
        {
          "text": "pathway",
          "start": 9.85,
          "end": 10.13
        }
      ]
    },
    {
      "start": 10.13,
      "end": 13.33,
      "text": "leads to experiences in a second pathway.",
      "words": [
