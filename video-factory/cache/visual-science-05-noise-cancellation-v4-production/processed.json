          "start": 14.86,
          "end": 15.47
        }
      ]
    },
    {
      "start": 15.47,
      "end": 18.68,
      "text": "When these two opposing waves collide,",
      "words": [
        {
          "text": "When",
          "start": 15.47,
          "end": 15.81
        },
        {
          "text": "these",
