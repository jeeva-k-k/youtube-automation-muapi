          "start": 10.0,
          "end": 10.71
        },
        {
          "text": "compute",
          "start": 10.71,
          "end": 11.27
        },
        {
          "text": "a",
          "start": 11.27,
          "end": 11.37
        },
        {
          "text": "matching",
          "start": 11.37,
          "end": 11.95
        },
        {
          "text": "wave,",
          "start": 11.95,
          "end": 12.27
        }
      ]
    },
    {
      "start": 12.27,
      "end": 15.47,
      "text": "but shifted exactly out of phase.",
      "words": [
        {
          "text": "but",
          "start": 12.27,
          "end": 12.56
        },
        {
          "text": "shifted",
          "start": 12.56,
          "end": 13.39
        },
        {
          "text": "exactly",
