  "captions": [
    {
      "start": 0.21,
      "end": 3.74,
      "text": "How do noise cancelling headphones block out sound?",
      "words": [
        {
          "text": "How",
          "start": 0.21,
          "end": 0.54
        },
        {
          "text": "do",
          "start": 0.54,
          "end": 0.73
        },
        {
          "text": "noise",
          "start": 0.73,
          "end": 1.17
        },
        {
          "text": "cancelling",
          "start": 1.17,
          "end": 1.99
        },
        {
          "text": "headphones",
          "start": 1.99,
          "end": 2.77
        },
        {
          "text": "block",
          "start": 2.77,
          "end": 3.08
        },
        {
          "text": "out",
          "start": 3.08,
          "end": 3.42
        },
        {
          "text": "sound?",
          "start": 3.42,
          "end": 3.74
        }
      ]
    },
    {
      "start": 3.74,
      "end": 5.87,
      "text": "They use the physics of sound waves.",
      "words": [
        {
          "text": "They",
          "start": 3.74,
          "end": 3.96
        },
        {
          "text": "use",
          "start": 3.96,
          "end": 4.26
        },
        {
          "text": "the",
          "start": 4.26,
          "end": 4.48
        },
        {
          "text": "physics",
          "start": 4.48,
          "end": 4.99
        },
        {
          "text": "of",
          "start": 4.99,
          "end": 5.18
        },
        {
          "text": "sound",
          "start": 5.18,
          "end": 5.48
        },
        {
          "text": "waves.",
          "start": 5.48,
          "end": 5.87
        }
      ]
    },
    {
      "start": 5.87,
      "end": 9.07,
      "text": "Tiny microphones on the outside detect ambient noise.",
      "words": [
        {
          "text": "Tiny",
          "start": 5.87,
          "end": 6.23
        },
        {
          "text": "microphones",
          "start": 6.23,
          "end": 7.03
        },
        {
          "text": "on",
          "start": 7.03,
          "end": 7.12
        },
        {
          "text": "the",
          "start": 7.12,
          "end": 7.3
        },
        {
          "text": "outside",
          "start": 7.3,
          "end": 7.85
        },
        {
          "text": "detect",
          "start": 7.85,
          "end": 8.26
        },
        {
          "text": "ambient",
          "start": 8.26,
          "end": 8.71
        },
        {
          "text": "noise.",
          "start": 8.71,
          "end": 9.07
        }
      ]
    },
    {
      "start": 9.07,
      "end": 12.27,
      "text": "The headphones instantly compute a matching wave,",
      "words": [
        {
          "text": "The",
          "start": 9.07,
          "end": 9.25
        },
        {
          "text": "headphones",
          "start": 9.25,
          "end": 10.0
        },
        {
