  "captions": [
    {
      "start": 0.21,
      "end": 3.66,
      "text": "Deep beneath the forest floor lies a network"
    },
    {
      "start": 3.66,
      "end": 6.27,
      "text": "known as the wood wide web."
    },
    {
      "start": 6.27,
      "end": 9.92,
      "text": "Trees share carbon, water, and vital nutrients"
    },
    {
      "start": 9.92,
      "end": 13.58,
      "text": "using underground networks of mycelium."
    },
    {
      "start": 13.58,
      "end": 17.24,
      "text": "They even send warning signals"
    },
    {
      "start": 17.24,
      "end": 20.37,
      "text": "about incoming insect attacks."
    },
    {
      "start": 20.37,
      "end": 23.51,
      "text": "A forest is not just a collection of trees;"
    },
    {
      "start": 23.51,
      "end": 26.64,
      "text": "it is a single cooperative organism."
    }
  ]
