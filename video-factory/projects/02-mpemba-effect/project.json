  "captions": [
    {
      "start": 0.17,
      "end": 3,
      "text": "Ever heard of the Mpemba Effect?"
    },
    {
      "start": 3,
      "end": 4.28,
      "text": "Under certain conditions,"
    },
    {
      "start": 4.28,
      "end": 5.57,
      "text": "hot water freezes faster than cold water."
    },
    {
      "start": 5.57,
      "end": 7.28,
      "text": "This physics paradox happens"
    },
    {
      "start": 7.28,
      "end": 8.57,
      "text": "because hot water evaporates quicker,"
    },
    {
      "start": 8.57,
      "end": 10.28,
      "text": "reducing its overall mass."
    },
    {
      "start": 10.28,
      "end": 12,
      "text": "Convection currents also"
    },
    {
      "start": 12,
      "end": 13.28,
      "text": "circulate heat faster,"
    },
    {
      "start": 13.28,
      "end": 15.85,
      "text": "cooling the liquid down rapidly."
    },
    {
      "start": 15.85,
      "end": 17.57,
      "text": "And dissolved gases"
    },
    {
      "start": 17.57,
      "end": 18.85,
      "text": "that slow down freezing are pushed out."
    },
    {
      "start": 18.85,
      "end": 20.57,
      "text": "Leaving purer water to crystallize."
    },
    {
      "start": 20.57,
      "end": 22.71,
      "text": "The science of heat and cold"
    },
    {
      "start": 22.71,
      "end": 25.28,
      "text": "is full of surprises."
    }
  ]
}