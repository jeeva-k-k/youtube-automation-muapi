  "captions": [
    {
      "start": 0.22,
      "end": 3.81,
      "text": "Why do onions make us cry?"
    },
    {
      "start": 3.81,
      "end": 5.98,
      "text": "It is a chemical defense system."
    },
    {
      "start": 5.98,
      "end": 9.25,
      "text": "When you slice an onion, you rupture its cells,"
    },
    {
      "start": 9.25,
      "end": 12.51,
      "text": "mixing enzymes that form a volatile gas."
    },
    {
      "start": 12.51,
      "end": 15.77,
      "text": "When this gas reaches your eyes,"
    },
    {
      "start": 15.77,
      "end": 19.03,
      "text": "it reacts with water to form a mild acid."
    },
    {
      "start": 19.03,
      "end": 22.3,
      "text": "This triggers your tear ducts."
    },
    {
      "start": 22.3,
      "end": 25.56,
      "text": "Slicing is triggering a chemical trap."
    }
  ]
