    {
      "start": 0.215,
      "end": 3.761,
      "text": "Global winds do not blow in straight lines."
    },
    {
      "start": 3.761,
      "end": 7.523,
      "text": "Because Earth rotates on its axis, moving air is deflected."
    },
    {
      "start": 7.523,
      "end": 11.284,
      "text": "In the Northern Hemisphere, winds curve to the right,"
    },
    {
      "start": 11.284,
      "end": 15.045,
      "text": "spinning cyclonic storms counter-clockwise."
    },
    {
      "start": 15.045,
      "end": 18.807,
      "text": "In the Southern Hemisphere, they deflect to the left."
    },
    {
      "start": 18.807,
      "end": 22.568,
      "text": "This atmospheric rotation dictates local hurricane pathways."
    }
  ],
