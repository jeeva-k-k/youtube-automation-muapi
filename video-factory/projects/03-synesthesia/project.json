  "captions": [
    {
      "start": 0.21,
      "end": 2.13,
      "text": "Imagine tasting a word,"
    },
    {
      "start": 2.13,
      "end": 3.73,
      "text": "or hearing the color green."
    },
    {
      "start": 3.73,
      "end": 6.4,
      "text": "This sensory blending is called synesthesia."
    },
    {
      "start": 6.4,
      "end": 8.53,
      "text": "It is a neurological condition"
    },
    {
      "start": 8.53,
      "end": 10.13,
      "text": "where stimulation of one sensory pathway"
    },
    {
      "start": 10.13,
      "end": 13.33,
      "text": "leads to experiences in a second pathway."
    },
    {
      "start": 13.33,
      "end": 17.06,
      "text": "This happens due to cross activation"
    },
    {
      "start": 17.06,
      "end": 20.26,
      "text": "between adjacent brain regions."
    },
    {
      "start": 20.26,
      "end": 22.92,
      "text": "What we call reality is entirely constructed"
    },
    {
      "start": 22.92,
      "end": 26.12,
      "text": "by the pathways in our mind."
    }
  ]
