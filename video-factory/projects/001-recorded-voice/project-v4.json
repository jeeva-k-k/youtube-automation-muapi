    {"id":"hook","start":0.00,"end":5.18,"eyebrow":"VOICE MEMO","title":"WHY DOES MY VOICE SOUND WRONG?"},
    {"id":"routes","start":5.18,"end":10.80,"eyebrow":"YOUR PRIVATE LISTENING MIX","title":"TWO PATHS. ONE VOICE."},
    {"id":"air","start":10.80,"end":16.98,"eyebrow":"PATH 01 · AIR","title":"MOUTH → AIR → INNER EAR"},
    {"id":"bone","start":16.98,"end":25.42,"eyebrow":"PATH 02 · BONE","title":"SKULL VIBRATION → INNER EAR"},
