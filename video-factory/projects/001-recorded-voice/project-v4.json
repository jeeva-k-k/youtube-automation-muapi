  "captions": [
    {"start":0.35,"end":2.61,"text":"Ever heard a recording of yourself?"},
    {"start":3.04,"end":5.18,"text":"And thought, that cannot be me?"},
    {"start":5.18,"end":7.48,"text":"It is you, but when you speak,"},
    {"start":7.48,"end":10.80,"text":"you hear your voice through two routes."},
    {"start":10.80,"end":13.71,"text":"First, sound travels through the air"},
    {"start":13.71,"end":16.98,"text":"into your ear canal, like other voices do."},
    {"start":16.98,"end":21.42,"text":"At the same time, vibrations move through your skull"},
    {"start":21.42,"end":25.42,"text":"toward the inner ear."},
    {"start":25.42,"end":29.53,"text":"Bone conduction changes the frequency balance,"},
    {"start":29.53,"end":33.00,"text":"often making your voice feel"},
    {"start":33.00,"end":35.41,"text":"fuller and deeper inside your head."},
    {"start":35.41,"end":39.35,"text":"A microphone mostly captures the air path,"},
    {"start":39.35,"end":41.83,"text":"without the internal vibration."},
    {"start":41.83,"end":43.54,"text":"Room, microphone, and speaker color it again."},
    {"start":43.54,"end":45.55,"text":"The recording sounds unfamiliar"},
    {"start":45.55,"end":47.56,"text":"because one pathway from your private mix is missing."}
  ]
}
