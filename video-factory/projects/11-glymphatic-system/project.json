    },
    {
      "start": 14.29,
      "end": 18.02,
      "text": "allowing cerebrospinal fluid to rush through."
    },
    {
      "start": 18.02,
      "end": 21.74,
      "text": "This cellular wash cycles out toxic proteins,"
    },
    {
      "start": 21.74,
