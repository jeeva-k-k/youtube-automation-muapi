  "captions": [
    {
      "start": 0.22,
      "end": 3.82,
      "text": "Why does a spinning ball curve in mid-air?"
    },
    {
      "start": 3.82,
      "end": 6,
      "text": "This is the Magnus Effect."
    },
    {
      "start": 6,
      "end": 9.27,
      "text": "As the ball rotates, it drags boundary air."
    },
    {
      "start": 9.27,
      "end": 12.55,
      "text": "On one side, this drag accelerates airflow,"
    },
    {
      "start": 12.55,
      "end": 15.82,
      "text": "lowering pressure."
    },
    {
      "start": 15.82,
      "end": 19.09,
      "text": "On the other side, it slows flow, raising pressure."
    },
    {
      "start": 19.09,
      "end": 22.37,
      "text": "The ball is sucked toward the low-pressure side,"
    },
    {
      "start": 22.37,
      "end": 25.64,
      "text": "curving its path."
    }
  ]
